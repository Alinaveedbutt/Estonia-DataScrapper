# ==========================================
# Estonia Company Pipeline - Environment Variables
# ==========================================
# No database. No paid APIs.
# Open data is free from e-Business Register (RIK).
# Cold-call product: official Phone + Email from register Contacts.

# 1. GOOGLE APPS SCRIPT WEBHOOK (for Sheets sync)
# Create a Google Sheet, paste google-apps-script/Code.gs, deploy as Web App
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your_deployment_id/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="your_strong_random_secret_here"

# 2. OPEN DATA (optional overrides)
# Default: official General data JSON zip (includes Contacts)
# ESTONIA_GENERAL_DATA_URL="https://avaandmed.ariregister.rik.ee/sites/default/files/avaandmed/ettevotja_rekvisiidid__yldandmed.json.zip"
# Use a local zip/json instead of downloading (dev / CI fixtures)
# ESTONIA_LOCAL_DUMP_PATH="./data/ettevotja_rekvisiidid__yldandmed.json.zip"
# ESTONIA_DATA_DIR="./data"
# First-run lookback when no checkpoint file exists
ESTONIA_LOOKBACK_DAYS="7"

# 3. SHEETS FILTERS (cold-call defaults)
# Sync only NO_WEBSITE rows (default false = sync all, sorted NO_WEBSITE first)
SHEETS_NO_WEBSITE_ONLY="false"
# Require at least phone or email (ignored when REQUIRE_PHONE=true)
SHEETS_REQUIRE_CONTACT="false"
# Default true — only sync rows with an official register phone (cold-call)
# Set false to also sync email-only / no-contact rows
SHEETS_REQUIRE_PHONE="true"

# 4. TUNING (optional)
LOG_LEVEL="info"
MAX_COMPANIES_PER_RUN="200"
PIPELINE_CONCURRENCY="4"
WEBSITE_PROBE_ENABLED="true"
WEBSITE_MAX_PROBES="4"
WEBSITE_PAGE_TIMEOUT_MS="5000"
WEBSITE_COMPANY_TIMEOUT_MS="20000"
