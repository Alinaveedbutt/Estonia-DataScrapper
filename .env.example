# ==========================================
# UK Company Pipeline - Environment Variables
# ==========================================

# 1. DATABASE
# Neon Free-tier PostgreSQL connection string
DATABASE_URL="postgresql://user:password@ep-something.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. COMPANIES HOUSE
# Free developer API key from Companies House Developer Hub
COMPANIES_HOUSE_API_KEY="your_ch_api_key_here"

# 3. GOOGLE APPS SCRIPT WEBHOOK (PRODUCTION)
# Create a Google Sheet, add the Code.gs, deploy as Web App, and paste URL here
GOOGLE_SHEETS_WEBHOOK_URL="https://script.google.com/macros/s/your_deployment_id/exec"
GOOGLE_SHEETS_WEBHOOK_SECRET="your_strong_random_secret_here"

# 4. TUNING (Optional)
LOG_LEVEL="info"
CRAWL_MAX_PAGES="8"
MAX_COMPANIES_PER_RUN="100"
MAX_LOG_RETENTION_DAYS="30"
# Optional search engine (disabled by default — direct public sources are primary)
ENABLE_OPTIONAL_SEARCH="false"
NO_WEBSITE_MAX_PAGE_FETCHES="8"
NO_WEBSITE_MAX_SEARCH_REQUESTS="0"
NO_WEBSITE_COMPANY_TIMEOUT_MS="45000"
NO_WEBSITE_PAGE_TIMEOUT_MS="5000"
NO_WEBSITE_SEARCH_TIMEOUT_MS="4000"
WEBSITE_MAX_SEARCH_REQUESTS="1"
WEBSITE_COMPANY_TIMEOUT_MS="30000"
WEBSITE_PAGE_TIMEOUT_MS="5000"
WEBSITE_SEARCH_TIMEOUT_MS="4000"
# Optional Yolist free-tier API key (unauthenticated tier works without key; key unlocks full phone fields)
# YOLIST_API_KEY="bsk_live_..."
