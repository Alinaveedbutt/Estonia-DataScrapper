datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// All newly discovered UK companies — both with and without websites.
model Company {
  company_number   String    @id
  company_name     String
  date_of_creation DateTime?
  company_status   String?
  company_type     String?

  address_line_1 String?
  address_line_2 String?
  locality       String?
  region         String?
  postal_code    String?
  country        String?
  full_address   String?

  website_status     String?  @default("PENDING")
  website_url        String?
  website_source     String?
  website_confidence String?

  phone              String?
  phone_normalized   String?
  phone_source_url   String?
  phone_source_type  String?
  phone_confidence   String?
  phone_last_checked DateTime?
  phone_missing_reason String?

  email              String?
  email_source_url   String?
  email_source_type  String?
  email_confidence   String?
  email_last_checked DateTime?
  email_missing_reason String?

  contact_status   String?   @default("PENDING")
  missing_reason   String?

  processing_status String?  @default("pending")
  enrichment_attempts Int    @default(0)
  last_enrichment_attempt DateTime?

  first_seen        DateTime @default(now())
  last_checked      DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model ProcessingLog {
  id             String   @id @default(uuid())
  company_number String
  company_name   String?
  stage          String
  status         String
  error_message  String?
  retry_count    Int      @default(0)
  source_url     String?
  timestamp      DateTime @default(now())

  @@index([company_number])
  @@index([timestamp])
}

model PipelineState {
  id                   String   @id @default("default")
  last_successful_scan DateTime?
  last_attempted_scan  DateTime?
  companies_processed  Int      @default(0)
  companies_checked    Int      @default(0)
  companies_with_website Int    @default(0)
  google_cse_queries_date String?
  google_cse_queries_today Int   @default(0)
  updated_at           DateTime @updatedAt
}
